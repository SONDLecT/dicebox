# Copy to .env and fill in. Only needed to deploy; the app itself needs nothing.
#
# Create a token at https://dash.cloudflare.com/profile/api-tokens with:
#   Account | Workers Scripts  | Edit
#   Zone    | Workers Routes   | Edit   (for the custom domain)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- deploy targets ---

# The relay a production deploy points the app at. Substituted into index.html
# at deploy time. Leave it unset and the live site ships with no relay, which
# is a supported outcome — the app is local-only and the Share panel says so —
# but it is not usually the one you meant.
RELAY_URL=wss://relay.example.com/ws

# The same for `npm run deploy:dev`. Defaults to wss://dev.relay.<your domain>/ws.
# DEV_RELAY_URL=wss://dev.relay.example.com/ws

# Hostnames for the dev copies. Both default to dev.<the production hostname>
# in wrangler.jsonc, so set these only if that is not where you want them.
# DEV_HOSTNAME=dev.example.com
# DEV_RELAY_HOSTNAME=dev.relay.example.com
