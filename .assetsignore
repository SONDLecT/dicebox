# Everything here is development-only. Same format as .gitignore.
.git
.gitignore
.assetsignore
node_modules
tools
package.json
package-lock.json
wrangler.jsonc
README.md
# Consumed by the deploy, never served: _headers is a Pages feature, so on
# Workers these rules are applied by the Worker script instead.
_headers
worker.js

# Shipped explicitly to the site root by tools/deploy.mjs.
dist

# Screenshots for the README; not part of the app.
docs

# The Owlbear Rodeo panel. A separate build for a separate origin, with headers
# of its own — it permits being framed, which this origin must never do. Serving
# it from here would put a framable copy of the app on the same host as the one
# that refuses to be framed, which gives up the protection entirely.
owlbear
